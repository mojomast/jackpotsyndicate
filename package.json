{
  "name": "jackpotsyndicate",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @jackpotsyndicate/game dev",
    "preview": "pnpm --filter @jackpotsyndicate/game exec vite preview",
    "test": "tsx --test \"packages/*/tests/**/*.test.ts\" \"apps/game/tests/**/*.test.tsx\"",
    "sim": "tsx tools/sim/src/index.ts",
    "e2e": "playwright test",
    "sim:rake": "tsx tools/physics-harness/rake.ts",
    "sim:perf": "tsx tools/physics-harness/perf.ts",
    "sim:hitrate": "tsx tools/sim/src/index.ts hitrate",
    "sim:balance": "tsx tools/sim/src/index.ts balance",
    "sim:replay": "tsx tools/sim/src/index.ts replay",
    "assets:build": "tsx tools/assets/src/index.ts build",
    "assets:verify": "tsx tools/assets/src/index.ts verify",
    "perf": "tsx apps/game/scripts/perf.ts",
    "release:zip": "pnpm build && cd apps/game/dist && zip -qr ../../../artifacts/jackpotsyndicate-release.zip . && cd ../../.. && sha256sum artifacts/jackpotsyndicate-release.zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
