{
  "name": "jackpotsyndicate",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r --if-present build",
    "test": "tsx --test \"packages/*/tests/**/*.test.ts\"",
    "sim:rake": "tsx tools/physics-harness/rake.ts",
    "sim:perf": "tsx tools/physics-harness/perf.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
