{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@jackpotsyndicate/contracts": ["./packages/contracts/src/index.ts"],
      "@jackpotsyndicate/physics": ["./packages/physics/src/index.ts"]
    }
  }
}
