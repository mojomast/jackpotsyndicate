{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "resolveJsonModule": true, "allowImportingTsExtensions": false,
    "types": ["node", "vite/client"], "noEmit": true
  },
  "include": ["src", "demo", "compositions", "tests", "vite.config.ts", "vitest.config.ts"]
}
